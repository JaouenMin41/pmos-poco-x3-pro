From f5401d112f265d06073b3e77546f928482f62521 Mon Sep 17 00:00:00 2001
From: Jaouen <74923920+JaouenMin41@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:37:06 +0000
Subject: [PATCH 5/5] arm64: configs: sm8150: update the POCO X3 Pro section

Drop the options of the downstream touchscreen driver that is no longer
in the tree and enable the new panel, touchscreen, backlight and IR
drivers used by the vayu device tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Maqjg6rG5ZJyxi8ZriSu69
---
 arch/arm64/configs/sm8150.config | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/sm8150.config b/arch/arm64/configs/sm8150.config
index 091437624..c5acd6904 100644
--- a/arch/arm64/configs/sm8150.config
+++ b/arch/arm64/configs/sm8150.config
@@ -14,13 +14,15 @@ CONFIG_SND_SOC_CS35L41_I2C=m
 CONFIG_CHARGER_IDTP9418=m
 
 # Xiaomi POCO X3 Pro
-CONFIG_SPI_XIAOMI_TP=y
-CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
-CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y
-CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
+CONFIG_DRM_PANEL_XIAOMI_VAYU_NT36672C=y
+CONFIG_TOUCHSCREEN_NT36XXX_SPI=m
+CONFIG_BACKLIGHT_QCOM_WLED=m
 CONFIG_SND_SOC_TAS2562=m
 CONFIG_NFC_NXP_NCI=m
 CONFIG_NFC_NXP_NCI_I2C=m
+CONFIG_LIRC=y
+CONFIG_RC_DEVICES=y
+CONFIG_IR_SPI=m
 
 # Oneplus 7 Pro
 CONFIG_TOUCHSCREEN_S6SY761=m
