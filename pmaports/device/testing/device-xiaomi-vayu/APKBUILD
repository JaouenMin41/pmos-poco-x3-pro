# Maintainer: Arseniy Velikanov <adomerlee@gmail.com>
# Contributor: Jaouen <74923920+JaouenMin41@users.noreply.github.com>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-vayu
pkgdesc="Xiaomi POCO X3 Pro"
pkgver=2
pkgrel=100
url="https://github.com/JaouenMin41/pmos-poco-x3-pro"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8150
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	phoc.ini
"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-phosh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, Modem, WiFi, Bluetooth, Touchscreen, etc."
	depends="
		firmware-xiaomi-vayu-adreno
		firmware-xiaomi-vayu-adsp
		firmware-xiaomi-vayu-ath10k
		firmware-xiaomi-vayu-cdsp
		firmware-xiaomi-vayu-modem
		firmware-xiaomi-vayu-touchscreen
		firmware-xiaomi-vayu-wlan
		linux-firmware-qca
		msm-modem
		pd-mapper
		tqftpserv
		"
	install="$subpkgname.post-install"
	mkdir "$subpkgdir"
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel phosh"
	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini
}

