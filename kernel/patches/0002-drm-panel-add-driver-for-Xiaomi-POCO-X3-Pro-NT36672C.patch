+struct vayu_panel_desc {
+	void (*init)(struct mipi_dsi_multi_context *dsi_ctx);
+};
+
+struct vayu_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator *supply;
+	struct gpio_desc *reset_gpio;
+	const struct vayu_panel_desc *desc;
+};
+
+static inline struct vayu_panel *to_vayu_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct vayu_panel, panel);
+}
+
+static void vayu_panel_reset(struct vayu_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
