From 853d0dd1004fe30269cb3f07f7403e764385f715 Mon Sep 17 00:00:00 2001
From: Jaouen <74923920+JaouenMin41@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:32:04 +0000
Subject: [PATCH 2/5] drm/panel: add driver for Xiaomi POCO X3 Pro NT36672C
 panels

The POCO X3 Pro (vayu) ships with one of two 1080x2400 120 Hz video
mode DSC LCD panels driven by a Novatek NT36672C controller:
  - Tianma (downstream: dsi_j20s_36_02_0a_video_display)
  - CSOT   (downstream: dsi_j20s_42_02_0b_video_display)

Both share the same timings and DSC configuration and only differ in
their initialization sequence. The sequences were generated with
linux-mdss-dsi-panel-driver-generator from the vendor device tree
(MiCode/Xiaomi_Kernel_OpenSource, branch vayu-r-oss).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Maqjg6rG5ZJyxi8ZriSu69
---
 drivers/gpu/drm/panel/Kconfig                 |  12 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../drm/panel/panel-xiaomi-vayu-nt36672c.c    | 486 ++++++++++++++++++
 3 files changed, 499 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-xiaomi-vayu-nt36672c.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index d3aaea989..b52605035 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1135,6 +1135,18 @@ config DRM_PANEL_WIDECHIPS_WS2401
 	  480x800 display controller used in panels such as Samsung LMS380KF01.
 	  This display is used in the Samsung Galaxy Ace 2 GT-I8160 (Codina).
 
+config DRM_PANEL_XIAOMI_VAYU_NT36672C
+	tristate "Xiaomi POCO X3 Pro (vayu) NT36672C DSC panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here if you want to enable support for the Tianma and CSOT
+	  1080x2400 120 Hz video mode DSC panels, driven by a Novatek
+	  NT36672C controller, found in the Xiaomi POCO X3 Pro.
+
