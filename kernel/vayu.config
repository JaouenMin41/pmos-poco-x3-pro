# Fragment noyau propre au POCO X3 Pro, appliqué après defconfig + sm8150.config.
# Les options principales sont déjà dans sm8150.config (patch 0005) ; ce fichier
# sert aux réglages de développement.

# Écran et tactile
CONFIG_DRM_PANEL_XIAOMI_VAYU_NT36672C=y
CONFIG_TOUCHSCREEN_NT36XXX_SPI=m
CONFIG_BACKLIGHT_QCOM_WLED=m

# NFC et infrarouge
CONFIG_NFC_NXP_NCI=m
CONFIG_NFC_NXP_NCI_I2C=m
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=m

# Logs persistants en RAM (ramoops), utiles quand le démarrage échoue
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Exigences pmbootstrap "kconfigcheck-community" absentes de sm8150.config
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_DM_INTEGRITY=m
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
# CONFIG_USB_MASS_STORAGE is not set
